<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Data Sell Out Bulanan</h1><div class="sub">Data yang dikirim rutin tiap bulan. Dipakai untuk baseline, saran toko eligible, dan aktual pencairan.</div></div>
</div>
<div class="row g-3">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-upload"></i> Upload data</div>
      <div class="card-body">
        <p class="small text-muted">Kolom: <code>customer_id</code>, <code>periode</code> (YYYY-MM), <code>brand</code>, <code>sell_out</code>, <code>sell_in</code>. Data periode + toko + brand yang sama akan ditimpa.</p>
        <form method="post" action="/master/sales/upload" enctype="multipart/form-data">
          <input type="file" name="file" accept=".xlsx,.csv" class="form-control mb-2" required>
          <button class="btn btn-primary w-100">Upload</button>
        </form>
        <a href="/master/sales/template" class="btn btn-link px-0 mt-2"><i class="bi bi-download"></i> Download template</a>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card">
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Periode</th><th class="num">Toko</th><th class="num">Sell out</th><th class="num">Sell in</th><th class="num">SO:SI</th><th>Update terakhir</th></tr></thead>
          <tbody>
            <% for (const s of summary) { %>
              <tr><td><%= h.month(s.period) %></td><td class="num"><%= s.stores %></td><td class="num"><%= h.rpShort(s.sellout) %></td><td class="num"><%= h.rpShort(s.sellin) %></td>
                <td class="num"><%= h.pct(s.sellin ? s.sellout / s.sellin * 100 : null) %></td><td class="small text-muted"><%= h.datetime(s.uploaded_at) %></td></tr>
            <% } %>
            <% if (!summary.length) { %><tr><td colspan="6" class="text-muted text-center py-4">Belum ada data.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
