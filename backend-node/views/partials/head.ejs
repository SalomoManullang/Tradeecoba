<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Tradee 2027</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/static/css/app.css" rel="stylesheet">
</head>
<body>
<% if (typeof bare !== 'undefined' && bare) { %>
<main class="bare">
<% } else {
  const r = user ? user.role : null;
  const is = (...roles) => roles.includes(r);
  const active = (p) => path === p || (p !== '/' && path.startsWith(p)) ? 'active' : '';
  const menu = [
    ['/', 'speedometer2', 'Dashboard', true],
    ['/setup', 'sliders', 'Setup Program', is('ADMIN_HO')],
    ['/registration', 'shop', 'Pendaftaran Toko', is('CBD', 'ADMIN_HO')],
    ['/registration/participants', 'people', 'Peserta', true],
    ['/inbox', 'inbox', 'Inbox Approval', true],
    ['/disbursement', 'cash-coin', 'Pencairan', true],
  ];
  const master = [
    ['/master/sales', 'graph-up', 'Data Sell Out', is('ADMIN_HO')],
    ['/master/stores', 'building', 'Master Toko', true],
    ['/master/data', 'tags', 'Channel & Brand', is('ADMIN_HO')],
  ];
%>
<div class="layout">
  <aside class="sidebar">
    <a href="/" class="brand"><i class="bi bi-compass"></i> Tradee <span>2027</span></a>
    <div class="year-chip">
      <span>Tahun program</span>
      <strong><%= year || '-' %></strong>
      <a href="/lobby" title="Ganti tahun"><i class="bi bi-arrow-left-right"></i></a>
    </div>
    <nav>
      <% for (const [href, icon, label, show] of menu) { if (!show) continue; %>
        <a href="<%= href %>" class="<%= href === '/registration' ? (path === '/registration' || path.startsWith('/registration/program') ? 'active' : '') : active(href) %>">
          <i class="bi bi-<%= icon %>"></i> <%= label %>
          <% if (href === '/inbox' && inboxCount > 0) { %><span class="badge rounded-pill text-bg-danger ms-auto"><%= inboxCount %></span><% } %>
        </a>
      <% } %>
      <div class="nav-section">Master Data</div>
      <% for (const [href, icon, label, show] of master) { if (!show) continue; %>
        <a href="<%= href %>" class="<%= active(href) %>"><i class="bi bi-<%= icon %>"></i> <%= label %></a>
      <% } %>
    </nav>
    <div class="user-box">
      <div class="fw-semibold"><%= user.name %></div>
      <div class="small text-white-50"><%= h.ROLE_LABEL[user.role] %>
        <% if (user.channel_codes) { %> · <%= user.channel_codes.join(', ') %><% } %>
        <% if (user.dc_codes) { %> · DC <%= user.dc_codes.join(', ') %><% } %>
      </div>
      <a href="/logout" class="small"><i class="bi bi-box-arrow-right"></i> Keluar</a>
    </div>
  </aside>
  <main class="content">
    <div class="proto-banner"><i class="bi bi-cone-striped"></i> Prototype terpisah dari aplikasi Tradee — semua data adalah dummy.</div>
<% } %>
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
    <%- flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
